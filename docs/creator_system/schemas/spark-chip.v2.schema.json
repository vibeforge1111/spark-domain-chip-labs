{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkswarm.ai/schemas/spark-chip/spark-chip.v2.schema.json",
  "title": "Spark Chip Manifest v2",
  "description": "One manifest standard for runtime chips. Additive-only evolution: known keys are never repurposed, deprecation is metadata, never deletion, and unknown root keys are permitted for forward-compatible readers.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_version",
    "schema_version",
    "io_protocol",
    "chip_name",
    "version",
    "domain",
    "description",
    "requires_runtime",
    "capabilities",
    "commands",
    "task_topics",
    "task_keywords"
  ],
  "properties": {
    "manifest_version": {
      "const": 2,
      "description": "Machine-comparable contract generation."
    },
    "schema_version": {
      "const": "spark-chip.v2",
      "description": "String compatibility signal for existing readers."
    },
    "io_protocol": {
      "const": "spark-hook-io.v1"
    },
    "chip_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Router and registry identity key."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requires_runtime": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "spark-intelligence-builder",
          "spark-harness-core",
          "spark-cli"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Runtime version range expression."
      },
      "description": "Engines-style runtime compatibility map."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Array argv form only. String-form commands are invalid in v2."
    },
    "task_topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_]*$"
      },
      "description": "Required router metadata for topic matching."
    },
    "task_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "Required router metadata for phrase or token matching."
    },
    "combine_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "default": [],
      "description": "Optional partner chip_name values."
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "health_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example_intents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "web_search": {
          "type": "boolean"
        },
        "allowed_mutations": {
          "type": "object"
        },
        "open_mutation_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_patterns": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_schema_version",
        "path_or_uri",
        "sha256"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
        },
        "packet_schema_version": {
          "const": "spark.evidence_scorecard_packet.v1"
        },
        "path_or_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tier_claim": {
          "enum": [
            "experimental",
            "conformant",
            "certified"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Optional hash-pinned pointer to an executed evidence scorecard packet."
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of deprecated key name to migration note."
    }
  }
}
